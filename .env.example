# SMTP settings for the Vercel waitlist serverless function.
# Keep real credentials in Vercel environment variables or a local .env file.
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-ses-smtp-username
SMTP_PASS=replace-with-ses-smtp-password
WAITLIST_FROM_EMAIL=info@brokrapp.se
WAITLIST_TO_EMAIL=info@brokrapp.se
